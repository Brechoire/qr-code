# Copier vers .env puis renseigner les secrets :
#   Copy-Item .env.example .env
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Ne JAMAIS committer .env (voir .gitignore).

# Requis — l'app refuse de démarrer sans (ImproperlyConfigured).
DJANGO_SECRET_KEY=change-me-en-prod
# Requis — sel du hash des IP (RGPD : IP jamais stockées en clair).
QR_IP_HASH_SALT=change-me-en-prod

# False par défaut (sûr). Mettre True en local uniquement.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Domaine public du service (utilisé pour construire les short_url /r/<id>/).
# Figé dans les QR imprimés : en prod, https://qr.votre-domaine.fr
QR_SHORT_BASE_URL=http://127.0.0.1:8003
# Cooldown anti double-comptage (secondes) : 3600 = 1 scan/IP/heure (best-effort).
QR_SCAN_COOLDOWN_SECONDS=3600
# Créations/modifications max par heure et par IP (429 au-delà, 0 = illimité).
QR_CREATE_PER_HOUR=30
# Blocklist de domaines (séparés par des virgules, ex. phishing.example,malware.test).
QR_BLOCKLIST=
# Rétention des ScanEvent en jours (purge via manage.py purge_scanevents).
QR_RETENTION_DAYS=180
# Longueurs max acceptées par l'API.
QR_MAX_URL_LENGTH=2000
QR_MAX_PAYLOAD_LENGTH=4000
